# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials or API keys.

# Postgres on Neon (free tier). In the Neon console → Connect, copy both strings.
# Pooled (host contains "-pooler"): used by the app at runtime. Set this on the host too.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (no "-pooler"): used only by the Prisma CLI for migrate/seed. Not needed on the host.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Climate TRACE needs no authentication.

# Ember Data API key (free) — used by lib/sources/ember.ts to fetch
# India's grid electricity carbon intensity and generation mix.
# Register at https://ember-energy.org/data/api/
EMBER_API_KEY=""

# Groq API key (free tier) — AI drafting of an inventory from a description
# (src/app/api/ai/draft). Without it the rest of the app works; drafting
# shows a "not set" message. Get one at https://console.groq.com/keys
GROQ_API_KEY=""
# Optional: override the model (default openai/gpt-oss-120b; needs strict JSON-schema support).
GROQ_MODEL=""
