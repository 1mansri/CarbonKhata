# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real API keys.

# Prisma / SQLite (default is fine for local dev, no changes needed)
DATABASE_URL="file:./dev.db"

# data.gov.in API key (free) — used by lib/sources/datagovin.ts to fetch
# live CPCB datasets (effluent/emission standards, water/air quality).
# Register at https://data.gov.in/user/register and generate a key from
# your account page (My Account > API Keys).
DATA_GOV_IN_API_KEY=""
